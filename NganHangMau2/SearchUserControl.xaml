<UserControl x:Class="NganHangMau2.SearchUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NganHangMau2"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:IndexConverter x:Key="IndexConverter"/>
    </UserControl.Resources>
    <Grid>
        <materialDesign:Card Margin="5" Padding="10" Grid.ColumnSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <DatePicker
                            Margin="5"
                            Name="dtinputDate"
                            materialDesign:HintAssist.Hint="Ngày nhập"
                            materialDesign:TextFieldAssist.HasClearButton="True" 
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" Height="50" Grid.Column="0"/>

                        <TextBox x:Name="txtId"  
                                 materialDesign:HintAssist.Hint="Mã túi máu"
                                 HorizontalAlignment="Stretch"
                                 Foreground="Gray" 
                                 Margin="5" 
                                 PreviewKeyDown="txtId_PreviewKeyDown"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Grid.Column="1"/>
                    </Grid>

                    <!-- StackPanel for ABO and Rhesus Blood Type on the same row -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <ComboBox
                            Background="AntiqueWhite"
                            Margin="5"
                            Width="150"
                            x:Name="cmbABOBloodType"
                            materialDesign:HintAssist.Hint="Nhóm máu ABO"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}">
                        </ComboBox>
                        <ComboBox
                            Background="AntiqueWhite"
                            Margin="5"
                            Width="150"
                            x:Name="cmbRhesusBloodType" 
                            materialDesign:HintAssist.Hint="Nhóm máu Rhesus"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}">

                        </ComboBox>
                        <ComboBox 
                            Margin="5"
                            x:Name="cmbBloodProductType"
                            materialDesign:HintAssist.Hint="Loại chế phẩm"
                            Width="150" Style="{StaticResource MaterialDesignOutlinedComboBox}">

                        </ComboBox>

                        <ComboBox 
                            Margin="5"
                            x:Name="cmbVolume" 
                            materialDesign:HintAssist.Hint="Thể tích"
                            Width="150" Style="{StaticResource MaterialDesignOutlinedComboBox}">

                        </ComboBox>

                        <DatePicker
                            Margin="5"
                            x:Name="dtpProductionDate"
                            materialDesign:HintAssist.Hint="Ngày sản xuất"
                            materialDesign:TextFieldAssist.HasClearButton="True"    
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" Height="50" />

                        <DatePicker
                            Margin="5"
                            x:Name="dtpExpiryDate"
                            materialDesign:HintAssist.Hint="Hạn sử dụng"
                            materialDesign:TextFieldAssist.HasClearButton="True"   
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}" Height="50" />

                        <ComboBox
                            Background="AntiqueWhite"
                            Margin="5"
                            Width="150"
                            x:Name="cmbStatus" 
                            materialDesign:HintAssist.Hint="Trạng thái"
                            Style="{StaticResource MaterialDesignOutlinedComboBox}">

                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5,0,0,10">
                        <Button x:Name="btnSearch" Content="Search" Width="75" Click="btnSearch_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>
                        <Button x:Name="btnPrint" Content="Print" Width="75" Margin="10,0,0,0" Click="btnPrint_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>
                        <Button x:Name="btnClear" Content="Clear" Width="75" Margin="10,0,0,0" Click="btnClear_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>

                    </StackPanel>
                </StackPanel>

                <DataGrid Grid.Row="1" x:Name="dgvBloodBags"
                          AutoGenerateColumns="False" 
                          VerticalScrollBarVisibility="Auto"
                          IsReadOnly="True"
                          VirtualizingStackPanel.IsVirtualizing="False">
                    <DataGrid.Columns>
                        <!-- Column for row number -->
                        <DataGridTemplateColumn Header="STT">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource IndexConverter}">
                                                <Binding RelativeSource="{RelativeSource AncestorType={x:Type DataGridRow}}"/>
                                                <Binding RelativeSource="{RelativeSource AncestorType={x:Type DataGrid}}" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Mã túi máu" Binding="{Binding Id}" />
                        <DataGridTextColumn Header="Nhóm máu" Binding="{Binding BloodGroup}" />
                        <DataGridTextColumn Header="Loại chế phẩm" Binding="{Binding BloodProductType}" />
                        <DataGridTextColumn Header="Ngày sản xuất" Binding="{Binding ProductionDate, StringFormat=dd/MM/yyyy}" />
                        <DataGridTextColumn Header="Ngày hết hạn" Binding="{Binding ExpiryDate, StringFormat=dd/MM/yyyy}" />
                        <DataGridTextColumn Header="Ngày nhập" Binding="{Binding EnteredDate,  StringFormat=dd/MM/yyyy}"/>
                        <DataGridTextColumn Header="Người nhập" Binding="{Binding EnteredBy}" />
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" />

                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>

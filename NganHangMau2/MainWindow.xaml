<Window x:Class="NganHangMau2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NganHangMau2"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Blood Storage"  WindowState="Maximized">
    <Window.Resources>
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="LightBlue"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="70"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <materialDesign:Card Grid.Column="0"       
       x:Name="nav_pnl" HorizontalAlignment="Left" Width="55" Background="LightGray">
            <StackPanel x:Name="Sidebar" Background="LightGray">

                <Grid Height="90">
                    <!--// Menu title text //-->
                    <TextBlock Margin="0,0,0,42" Text="MENU" Foreground="Black" 
               FontSize="22"
               Background="Transparent"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom" Name="menu">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=nav_pnl, Path=Width}" Value="55">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ElementName=nav_pnl, Path=Width}" Value="170">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!--// Toggle Button //-->
                    <ToggleButton x:Name="SidebarToggleButton" Grid.Column="0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Left"
                  Margin="10,-20,0,0"
                  Height="30"
                  Width="30"
                  BorderThickness="0"
                  Checked="SidebarToggleButton_Checked"
                  Unchecked="SidebarToggleButton_Unchecked"    
                  Style="{StaticResource MaterialDesignHamburgerToggleButton}" >
                        <!--// Toggle Button - Checked, Unchecked events //-->
                        <ToggleButton.Triggers>
                            <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                <BeginStoryboard>
                                    <Storyboard x:Name="HideStackPanel">
                                        <DoubleAnimation    
                                Storyboard.TargetName="nav_pnl"
                                Storyboard.TargetProperty="Width"
                                BeginTime="0:0:0"
                                From="170" To="55"
                                Duration="0:0:0.3"
                                >
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="ToggleButton.Checked">
                                <BeginStoryboard>
                                    <Storyboard x:Name="ShowStackPanel">
                                        <DoubleAnimation    
                                Storyboard.TargetName="nav_pnl"
                                Storyboard.TargetProperty="Width"
                                BeginTime="0:0:0"
                                From="55" To="170"
                                Duration="0:0:0.3"
                                >
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ToggleButton.Triggers>
                    </ToggleButton>
                </Grid>

                <ListView  x:Name="SidebarMenu" Background="Transparent"  BorderBrush="Transparent"
   ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SidebarMenu_SelectionChanged">

                    <!--// Home //-->
                    <ListViewItem 
                        Tag="input"
                        FontSize="22"
                        Background="Transparent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Name="Input"
                        Margin="0,0,0,0">

                        <StackPanel Orientation="Horizontal" Width="170">
                            <materialDesign:PackIcon Kind="Import" Margin="5,0,0,0"
                                         Height="30" Width="30" />
                            <TextBlock Text="Nhập" Margin="5,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=nav_pnl, Path=Width}" Value="55">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=nav_pnl, Path=Width}" Value="170">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ListViewItem>
                    <!--// Home //-->


                    <ListViewItem  Name="Output"
                                   Tag="output"
                                   FontSize="22"
                                   Background="Transparent"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,0">
                        <StackPanel Orientation="Horizontal" Width="170">
                            <materialDesign:PackIcon Kind="Export" Margin="5,0,0,0"
                               Height="30" Width="30" />
                            <TextBlock Text="Xuất" Margin="5,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=nav_pnl, Path=Width}" Value="55">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=nav_pnl, Path=Width}" Value="170">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ListViewItem>
                    <!--// Home //-->
                    <ListViewItem 
                        Name="Search"
                        Margin="0,0,0,0" 
                        Tag="search"
                        FontSize="22"
                        Background="Transparent"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom">

                        <StackPanel Orientation="Horizontal" Width="170">
                            <materialDesign:PackIcon Kind="CardSearchOutline" Margin="5,0,0,0"
                               Height="30" Width="30" />
                            <TextBlock Text="Tìm kiếm" Margin="5,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ElementName=nav_pnl, Path=Width}" Value="55">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ElementName=nav_pnl, Path=Width}" Value="170">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </ListViewItem>
                </ListView>
       
            </StackPanel>
        </materialDesign:Card>
            

        <!-- Main Content -->
        <ContentControl x:Name="MainContent" Grid.Column="1" />
    </Grid>
</Window>

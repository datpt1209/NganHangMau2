<Window x:Class="NganHangMau2.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NganHangMau2"
        mc:Ignorable="d"
        Title="ConfigWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Server Name:" />
            <TextBox Name="txtServerName" />
            <TextBlock Text="Database Name:" Margin="0,10,0,0" />
            <TextBox Name="txtDatabaseName" />
            <TextBlock Text="User ID:" Margin="0,10,0,0" />
            <TextBox Name="txtUserId" />
            <TextBlock Text="Password:" Margin="0,10,0,0" />
            <PasswordBox Name="txtPassword" />
            <Button Content="Save" Margin="0,20,0,0" Click="btnSave_Click" />
        </StackPanel>
    </Grid>
</Window>
